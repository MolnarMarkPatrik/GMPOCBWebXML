<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <xs:element name="MM_orarend">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ora" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="targy" type="xs:string"/>
                            <xs:element name="idopont">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nap">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:string">
                                                    <xs:enumeration value="Hétfő"/>
                                                    <xs:enumeration value="Kedd"/>
                                                    <xs:enumeration value="Szerda"/>
                                                    <xs:enumeration value="Csütörtök"/>
                                                    <xs:enumeration value="Péntek"/>
                                                    <xs:enumeration value="Szombat"/>
                                                    <xs:enumeration value="Vasárnap"/>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:element>
                                        <xs:element name="tol" type="oraIdoTipus"/>
                                        <xs:element name="ig" type="oraIdoTipus"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="helyszin" type="xs:string"/>
                            <xs:element name="oktato" type="xs:string"/>
                            <xs:element name="szak" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
                        <xs:attribute name="típus" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:enumeration value="elmélet"/>
                                    <xs:enumeration value="gyakorlat"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="oraIdoTipus">
        <xs:restriction base="xs:string">
            <xs:pattern value="([01]?[0-9]|2[0-3]):[0-5][0-9]"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
